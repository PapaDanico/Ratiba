# =============================================================================
# Ratiba — environment configuration
# Copy to `.env` and fill in values. Never commit `.env`.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Local Docker development database. For Supabase production, set DATABASE_URL only
# in the backend host's secret environment using:
# postgresql+psycopg://postgres:[PERCENT_ENCODED_PASSWORD]@db.ntqtkgunwdvqmmgvrxjv.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://ratiba:dev_password@db:5432/ratiba
TEST_DATABASE_URL=postgresql+psycopg://ratiba:dev_password@db:5432/ratiba_test

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_PARSER=claude-sonnet-4-5
ANTHROPIC_MODEL_CONVERSATIONAL=claude-haiku-4-5

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://api.ratiba.aero/bot/webhook

# --- Security ----------------------------------------------------------------
# Generate via: openssl rand -hex 32
SECRET_KEY=change_me_dev_only_change_me_dev_only_change_me_dev_only_12345
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Browser sessions store their JWTs in httpOnly cookies. Set true wherever the
# dashboard is served over HTTPS so the cookies are marked Secure; leave false
# for local HTTP dev.
COOKIE_SECURE=false
# SameSite policy for the session cookies. "lax" suits the default same-site
# deployment (SPA + API behind one origin). Use "none" only if the dashboard and
# API live on different domains (forces Secure on).
COOKIE_SAMESITE=lax

# --- Compliance (KDPA / ODPC) ------------------------------------------------
KDPA_DATA_REGION=ke-1
KDPA_REGISTRATION_REF=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# --- URLs --------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Outbound messaging (all optional; a channel is skipped if unconfigured) -
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Africa's Talking — SMS + WhatsApp
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=Ratiba
# WhatsApp sender number; enables the WhatsApp notify channel when set
# (together with AT_API_KEY + AT_USERNAME).
AT_WHATSAPP_NUMBER=

# --- Audit pack storage (Phase 5 / 6) ----------------------------------------
# Local FS path when AUDIT_PACK_S3_BUCKET is unset.
AUDIT_PACK_DIR=/app/audit_packs
# Set to enable S3-compatible storage (ADC Nairobi, DO Spaces, MinIO, AWS).
AUDIT_PACK_S3_BUCKET=
AUDIT_PACK_S3_ENDPOINT=
AUDIT_PACK_S3_REGION=
