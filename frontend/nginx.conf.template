server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers (server-level → inherited by both location blocks, since
    # neither sets its own add_header). Don't leak the nginx version.
    server_tokens off;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data:; connect-src 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Dynamic resolution so nginx sends SNI on HTTPS upstreams.
    # Without this nginx resolves the hostname once at startup, connects by IP,
    # and Render's edge rejects the handshake (no SNI = wrong certificate).
    resolver 8.8.8.8 valid=30s ipv6=off;

    # Proxy backend routes: API, health, FastAPI docs.
    # Capture the full path so we can re-append it: with a *variable* proxy_pass
    # in a regex location, nginx does NOT append the original request URI, so
    # without this the path would be dropped and every /api call would hit the
    # backend root ("/") — login etc. would 404. $request_uri keeps the query
    # string too.
    location ~ ^/(api|healthz|version|docs|redoc|openapi\.json) {
        # Use a variable so nginx resolves per-request (enables SNI).
        set $upstream $BACKEND_URL;
        # FIX: Append $request_uri so nginx includes the full path + query.
        # Without this, POST /api/v1/auth/login reaches backend as POST /
        # (nginx behavior: variable proxy_pass drops URI unless explicitly appended).
        proxy_pass $upstream$request_uri;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $BACKEND_HOST;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        # Render free-tier backends spin down after ~15 min idle and take
        # 30-60s to cold-start. A short connect timeout would 502 ("Something
        # went wrong" on login) before the backend finishes waking, so allow
        # the full cold-start window to connect. The keep-warm cron normally
        # prevents the spin-down; this is the safety net for the first request
        # after an idle period.
        proxy_connect_timeout 75s;
        # Don't fail the first request mid-wake: if the upstream errors or
        # times out, retry it (covers the brief window as the instance comes up).
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 90s;
    }

    # SPA fallback — all non-asset paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
