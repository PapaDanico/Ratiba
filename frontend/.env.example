# Frontend Environment Variables

# API Base URL — set to backend service URL in production
# Default: /api (uses nginx proxy on same domain)
# Production: https://ratiba-api.onrender.com/api
VITE_API_BASE_URL=/api

# Sentry DSN for error tracking (optional)
# VITE_SENTRY_DSN=https://...

# Environment mode
VITE_ENV=development
